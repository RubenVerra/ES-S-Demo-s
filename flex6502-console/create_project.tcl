# --- 1. Locate the checkout -------------------------------------------------
# [info script] is the path of the file currently being sourced, which is this
# one. Normalising it gives an absolute path with forward slashes on every
# platform, which is what $readmemh wants.
if {[info script] ne ""} {
    set here [file normalize [file dirname [info script]]]
} else {
    set here [file normalize [pwd]]
    puts "WARNING: could not determine the script location, using [pwd]"
}

set part_name  "xc7z020clg484-1"
set proj_name  "flex6502_console"
set build_dir  [file join $here build]

puts "INFO: repository root : $here"
puts "INFO: target part     : $part_name"

# --- 2. Point the memory at the game image ---------------------------------
# memory_dual_port.v does `include "mem_path.vh" and loads whatever
# MEM_INIT_FILE points at. Writing it here is what removes the need for a
# hard-coded path in the source.
set image [file join $here memory games.list]
if {![file exists $image]} {
    error "game image not found: $image (is the checkout complete?)"
}

set vh [file join $here rtl mem_path.vh]
set fh [open $vh w]
puts $fh "// Generated by create_project.tcl - do not edit, do not commit."
puts $fh "`define MEM_INIT_FILE \"$image\""
close $fh
puts "INFO: wrote rtl/mem_path.vh -> $image"

# --- 3. Create the project --------------------------------------------------
create_project -force $proj_name $build_dir -part $part_name

set rtl_sources [list \
    [file join $here rtl flex6502.v]               \
    [file join $here rtl clock_generator.v]        \
    [file join $here rtl uart_rx.v]                \
    [file join $here rtl uart_tx.v]                \
    [file join $here rtl memory_dual_port.v]       \
    [file join $here rtl UART_setup_console.v]     \
    [file join $here rtl CPU_Test_with_Memory.v]   \
    [file join $here rtl Zedboard_cpu_top.vhd]     \
    [file join $here rtl UART_vga_top.vhd]         \
    [file join $here rtl vga_timing.vhd]           \
]

foreach f $rtl_sources {
    if {![file exists $f]} { error "missing source file: $f" }
}
add_files -norecurse -fileset sources_1 $rtl_sources

# states.v and mem_path.vh are pulled in with `include, so they must be marked
# as headers. If Vivado treats them as ordinary sources it tries to elaborate
# them on their own and reports errors about a file with no module in it.
set headers [list [file join $here rtl states.v] [file join $here rtl mem_path.vh]]
add_files -norecurse -fileset sources_1 $headers
foreach f $headers {
    set_property file_type "Verilog Header" [get_files $f]
}

# --- 4. Constraints ---------------------------------------------------------
set xdc [file join $here constraints Zedboard_Master.xdc]
if {![file exists $xdc]} { error "missing constraints file: $xdc" }
add_files -fileset constrs_1 -norecurse $xdc

# --- 5. Top level -----------------------------------------------------------
set_property top zedboard_cpu_top [get_filesets sources_1]
update_compile_order -fileset sources_1

puts "INFO: project created in $build_dir"

# --- 6. Optionally run the whole flow --------------------------------------
set want_bitstream 0
if {[info exists argv] && [lsearch -exact $argv "bit"] >= 0} {
    set want_bitstream 1
}

if {$want_bitstream} {
    puts "INFO: running synthesis and implementation, this takes a few minutes"
    launch_runs impl_1 -to_step write_bitstream -jobs 4
    wait_on_run impl_1

    if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} {
        error "implementation did not finish, check the run log in $build_dir"
    }

    set bit [file join $build_dir ${proj_name}.runs impl_1 zedboard_cpu_top.bit]
    if {[file exists $bit]} {
        file copy -force $bit [file join $here flex6502_console.bit]
        puts "INFO: bitstream copied to [file join $here flex6502_console.bit]"
    } else {
        puts "WARNING: implementation finished but no .bit was found at $bit"
    }
} else {
    puts ""
    puts "Next: open $build_dir/$proj_name.xpr and press Generate Bitstream,"
    puts "or re-run this script with -tclargs bit to do it headless."
}
